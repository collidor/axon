{
  "name": "@collidor/axon",
  "version": "0.1.0",
  "description": "High-performance modular node graph and execution engine with Web Component support",
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./src/core/index.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./headless": {
      "types": "./src/headless.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./systems": {
      "types": "./src/systems/index.ts",
      "import": "./dist/systems.js",
      "require": "./dist/systems.cjs"
    },
    "./web-components": {
      "types": "./src/web-components/index.ts",
      "import": "./dist/web-components.js",
      "require": "./dist/web-components.cjs"
    },
    "./web": {
      "types": "./src/web-components/index.ts",
      "import": "./dist/web-components.js",
      "require": "./dist/web-components.cjs"
    },
    "./nodes": {
      "types": "./src/nodes/index.ts",
      "import": "./dist/nodes.js",
      "require": "./dist/nodes.cjs"
    },
    "./compiler": {
      "types": "./src/compiler/index.ts",
      "import": "./dist/compiler.js",
      "require": "./dist/compiler.cjs"
    },
    "./state": {
      "types": "./src/state/index.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    },
    "./style.css": "./dist/axon.css"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/collidor/axon.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "test": "vp test run"
  },
  "dependencies": {
    "@collidor/command": "workspace:*",
    "@collidor/struct": "workspace:*",
    "@collidor/struct-command": "workspace:*",
    "@collidor/struct-event": "workspace:*",
    "@collidor/toolkit": "^0.2.0",
    "@collidor/ui": "workspace:*",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.0.1",
    "typescript": "~7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
