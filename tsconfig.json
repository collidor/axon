{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "..",
    "strict": true,
    "declaration": true,
    "declarationDir": "./dist",
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@collidor/command": ["../command/src/index.ts"],
      "@collidor/command/*": ["../command/src/*"],
      "@collidor/struct": ["../struct/src/index.ts"],
      "@collidor/struct/*": ["../struct/src/*"],
      "@collidor/ui": ["../ui/src/index.ts"],
      "@collidor/ui/*": ["../ui/src/*"]
    }
  },
  "include": ["src/**/*"]
}
